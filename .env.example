# ============================================================
# IITGN Maintenance Request System - configuration
# Every tunable lives here (parsed once in src/config/constants.ts).
# Values below are SUGGESTED DEFAULTS - tune with real traffic.
# ============================================================

# ---------- App ----------
APP_BASE_URL=https://maintenance.iitgn.ac.in
MAINTENANCE_MODE=false
ALLOWED_EMAIL_DOMAINS=            # comma-separated, e.g. iitgn.ac.in ; empty = any
DETAILS_MAX_CHARS=150             # legacy limit was 150
MIN_FORM_FILL_SECONDS=3           # anti-bot: faster than this = rejected

# ---------- Client IP / proxy ----------
TRUST_PROXY=false                 # true only if behind a proxy you control
CLIENT_IP_HEADER=x-forwarded-for  # header carrying the real IP when TRUST_PROXY=true
COOKIE_SECRET=change-me           # signs the anonymous client cookie

# ---------- Rate limiting ----------
RATE_LIMIT_DRIVER=memory          # memory | redis
REDIS_URL=
RATE_LIMIT_SUBMIT_MAX=10          # submissions per IP per window
RATE_LIMIT_SUBMIT_WINDOW_MINUTES=60
RATE_LIMIT_GLOBAL_PER_MINUTE=60   # all routes, per IP
RATE_LIMIT_FOLLOWUP_MAX=20        # per IP per hour
RATE_LIMIT_TRACK_LOOKUP_PER_HOUR=30
RATE_LIMIT_OPTIONS_PER_MINUTE=60
AUTO_BAN_AFTER_429S=0             # 0 = disabled
AUTO_BAN_MINUTES=30

# ---------- Abuse rules ----------
MAX_OPEN_REQUESTS_PER_EMAIL=5
DUPLICATE_WINDOW_MINUTES=30

# ---------- Captcha ----------
CAPTCHA_PROVIDER=turnstile        # turnstile | hcaptcha | disabled (dev only)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_FAIL_OPEN_IN_DEV=false

# ---------- Image upload ----------
UPLOAD_ENABLED=true               # kill switch
AUTH_REQUIRED_FOR_UPLOAD=false    # future: true once login exists
UPLOAD_MAX_IMAGES_PER_REQUEST=3
UPLOAD_MAX_FILE_SIZE_MB=5         # before processing
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
UPLOAD_CLIENT_MAX_DIMENSION_PX=1600
UPLOAD_CLIENT_QUALITY=0.75
UPLOAD_SERVER_MAX_DIMENSION_PX=1600
UPLOAD_MAX_PIXELS=40000000        # decompression-bomb guard
UPLOAD_OUTPUT_FORMAT=webp         # webp | jpeg
UPLOAD_OUTPUT_QUALITY=75
UPLOAD_THUMB_DIMENSION_PX=320
UPLOAD_MAX_IMAGES_PER_IP_PER_DAY=6
UPLOAD_MAX_MB_PER_IP_PER_DAY=20
UPLOAD_GLOBAL_DAILY_CAP_MB=2000
UPLOAD_GLOBAL_PER_MINUTE=30
UPLOAD_MAX_CONCURRENT_PROCESSING=2
UPLOAD_RETENTION_DAYS=180         # after request is closed
STORAGE_DRIVER=local              # local | s3
STORAGE_PATH=/var/mrs/uploads     # outside the web root

# ---------- Tracking and follow-ups ----------
MAX_FOLLOWUPS_PER_REQUEST=30
FOLLOWUP_MAX_CHARS=1000
REOPEN_WINDOW_DAYS=14
AUTO_CLOSE_DAYS=5                 # after Resolved with no reply

# ---------- Escalation (SLA hours) ----------
ESCALATION_L1_HOURS=24
ESCALATION_L2_HOURS=72
ESCALATION_L3_HOURS=168
# Contacts: copy the real addresses from legacy/index.html (Complaint Redressal modal)
ESCALATION_L1_CIVIL_EMAIL=
ESCALATION_L1_ELECTRICAL_EMAIL=
ESCALATION_L2_EMAIL=
ESCALATION_L3_EMAIL=
EMERGENCY_PHONE_NUMBERS=          # shown for urgent/safety requests

# ---------- Mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IITGN Maintenance <no-reply@iitgn.ac.in>"

# ---------- Database ----------
DATABASE_URL=                     # confirm existing DB (likely MySQL) before choosing

# ---------- Future (login) ----------
GUEST_SUBMISSION_ENABLED=true
VERIFIED_EMAIL_LIMIT_MULTIPLIER=2

# ---------- SuperApp Global Calendar API v1 ----------
# Shared base URL provided by SuperApp team
SUPERAPP_CALENDAR_BASE_URL=http://localhost:3001
SUPERAPP_MODULE_KEY=IWD
SUPERAPP_MODULE_TOKEN=your-server-side-module-token-never-expose-to-frontend
SUPERAPP_CALENDAR_ENABLED=true
SUPERAPP_TIMEZONE=Asia/Kolkata
